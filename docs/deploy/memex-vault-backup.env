# Memex vault backup env file — read by the systemd unit at
# ~/.config/systemd/user/memex-vault-backup.service.
#
# Most defaults are baked into scripts/memex-vault-backup.sh; the
# only required value is RESTIC_PASSWORD_FILE. Uncomment + edit to
# override anything else.

# ── Vault location (only if non-default) ────────────────────────────
# Default: ~/.memex/vault (or $XDG_DATA_HOME/memex/vault).
# MEMEX_VAULT_PATH=%h/.memex/vault

# ── Restic repository ───────────────────────────────────────────────
# Local default (the script's built-in):
#   RESTIC_REPOSITORY=%h/.local/state/memex/backups
#
# Backblaze B2:
#   RESTIC_REPOSITORY=b2:my-memex-vault-bucket:/
#   B2_ACCOUNT_ID=...
#   B2_ACCOUNT_KEY=...
#
# S3-compatible (AWS, MinIO, Wasabi):
#   RESTIC_REPOSITORY=s3:s3.us-east-1.amazonaws.com/my-bucket/memex
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#
# Remote SSH:
#   RESTIC_REPOSITORY=sftp:user@host:/path/to/backups

# ── Encryption password (REQUIRED) ──────────────────────────────────
# Restic encrypts every snapshot. Generate the file separately so it
# isn't visible in process listings:
#   mkdir -p ~/.config/memex
#   printf 'your-passphrase-of-choice' > ~/.config/memex/restic-password
#   chmod 600 ~/.config/memex/restic-password
RESTIC_PASSWORD_FILE=%h/.config/memex/restic-password

# ── Retention (only if you want non-default) ────────────────────────
# Defaults: 7 daily / 4 weekly / 6 monthly snapshots. `restic forget
# --prune` runs at the end of each backup, so the repo stays bounded.
# MEMEX_BACKUP_KEEP_DAILY=7
# MEMEX_BACKUP_KEEP_WEEKLY=4
# MEMEX_BACKUP_KEEP_MONTHLY=6

# ── Init policy ─────────────────────────────────────────────────────
# When true (default), the script runs `restic init` on first execution
# if the repo doesn't exist. Set to "false" if you'd rather initialize
# manually (e.g., to choose key derivation parameters).
# RESTIC_INIT_IF_MISSING=true

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Memex MCP server (HTTP transport) — macOS launchd user-agent template.

  Install with:
      mkdir -p ~/Library/LaunchAgents ~/.local/state/memex
      cp docs/deploy/com.memex.mcp.plist ~/Library/LaunchAgents/
      # Generate + paste a bearer token into EnvironmentVariables below:
      uv run memex mcp generate-token
      # EDIT the WorkingDirectory + ProgramArguments + EnvironmentVariables
      # below to match your clone, then:
      launchctl load -w ~/Library/LaunchAgents/com.memex.mcp.plist

  See docs/deploy/mcp-http.md for the bearer-auth story. Without
  MEMEX_MCP__AUTH_TOKEN set, the service refuses to bind to anything
  other than loopback.

  Tail with: tail -f ~/.local/state/memex/mcp.{out,err}.log
  Unload:    launchctl unload ~/Library/LaunchAgents/com.memex.mcp.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.memex.mcp</string>

  <!-- EDIT: path to your Memex clone. -->
  <key>WorkingDirectory</key>
  <string>/Users/YOUR_USER/project/Doc_Flo</string>

  <key>ProgramArguments</key>
  <array>
    <!-- EDIT: absolute path to your uv binary. -->
    <string>/Users/YOUR_USER/.local/bin/uv</string>
    <string>run</string>
    <string>memex</string>
    <string>serve</string>
    <string>mcp</string>
    <string>--transport</string>
    <string>http</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>7424</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOUR_USER/.local/bin:/usr/local/bin:/usr/bin:/bin</string>

    <!-- EDIT: paste a token generated by `uv run memex mcp generate-token`. -->
    <key>MEMEX_MCP__AUTH_TOKEN</key>
    <string>REPLACE_WITH_GENERATED_TOKEN</string>

    <!-- Optional overrides:
    <key>MEMEX_VAULT_PATH</key>
    <string>/Users/YOUR_USER/.memex/vault</string>
    <key>MEMEX_INFERENCE__BASE_URL</key>
    <string>http://127.0.0.1:8000/v1</string>
    -->
  </dict>

  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>2</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/.local/state/memex/mcp.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/.local/state/memex/mcp.err.log</string>
</dict>
</plist>

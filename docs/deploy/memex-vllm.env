# Memex vLLM env file — read by the systemd unit at
# ~/.config/systemd/user/memex-vllm.service.
#
# All values shown commented are the *defaults* baked into
# scripts/serve-vllm.sh. Uncomment + edit a line to override.

# ── Model + binding ─────────────────────────────────────────────────
# MEMEX_VLLM_MODEL=Qwen/Qwen3-8B-AWQ
# MEMEX_VLLM_HOST=127.0.0.1
# MEMEX_VLLM_PORT=8000

# ── Quantization + context ──────────────────────────────────────────
# MEMEX_VLLM_QUANTIZATION=awq_marlin   # set to "" for unquantized models
# MEMEX_VLLM_MAX_MODEL_LEN=4096

# ── GPU memory ──────────────────────────────────────────────────────
# 0.72 = empirical 12 GB-rig floor with the Qwen3-8B-AWQ + the
# in-process embedder + bge-reranker. Bump to 0.80 on a 16 GB+ card
# (gains KV cache headroom). Lower to 0.62 if you need to host the
# Qwen3-Reranker backend resident (see docs/ROADMAP.md P2.1).
# MEMEX_VLLM_GPU_FRACTION=0.72

# ── Device pinning ──────────────────────────────────────────────────
# CUDA_VISIBLE_DEVICES=0

# ── Compilation knob ────────────────────────────────────────────────
# Uncomment to disable CUDA-graph compilation (slower decode but
# faster startup, useful while debugging).
# MEMEX_VLLM_EAGER=1

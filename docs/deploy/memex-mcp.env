# Memex MCP server env file — read by the systemd unit at
# ~/.config/systemd/user/memex-mcp.service.
#
# Only one field is genuinely required: MEMEX_MCP__AUTH_TOKEN, if you
# plan to bind anywhere other than 127.0.0.1. The service refuses to
# start on a non-loopback address without a token (see P1.2 / the
# docs/deploy/mcp-http.md guide).

# ── Bearer token (REQUIRED for non-loopback bind) ───────────────────
# Generate with: uv run memex mcp generate-token
# MEMEX_MCP__AUTH_TOKEN=

# ── Vault location (only if non-default) ────────────────────────────
# MEMEX_VAULT_PATH=%h/.memex/vault

# ── Observability ───────────────────────────────────────────────────
# Off by default; set both keys to enable Langfuse tracing.
# MEMEX_OBSERVABILITY__LANGFUSE_ENABLED=false
# MEMEX_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
# MEMEX_OBSERVABILITY__LANGFUSE_SECRET_KEY=

# ── vLLM endpoint override (only if non-default) ────────────────────
# The `ask` tool calls vLLM over the OpenAI-compatible HTTP endpoint.
# Default: http://localhost:8000/v1 (matches memex-vllm.service).
# MEMEX_INFERENCE__BASE_URL=http://127.0.0.1:8000/v1

# Memex web UI env file — read by the systemd unit at
# ~/.config/systemd/user/memex-web.service.
#
# Most users don't need anything here; the defaults baked into the
# CLI flags + the global Memex config (~/.config/memex/config.toml)
# are usually right. Uncomment + edit to override.

# ── Vault location (only if non-default) ────────────────────────────
# Default: ~/.memex/vault (or $XDG_DATA_HOME/memex/vault).
# MEMEX_VAULT_PATH=%h/.memex/vault

# ── Observability ───────────────────────────────────────────────────
# Set MEMEX_OBSERVABILITY__LANGFUSE_ENABLED=true + both keys to
# enable tracing. Off by default (local-first / no-telemetry).
# MEMEX_OBSERVABILITY__LANGFUSE_ENABLED=false
# MEMEX_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
# MEMEX_OBSERVABILITY__LANGFUSE_SECRET_KEY=

# ── vLLM endpoint override (only if non-default) ────────────────────
# The agent talks to vLLM over the OpenAI-compatible HTTP endpoint.
# Default: http://localhost:8000/v1 (matches the memex-vllm.service
# bind). Override only if you're running vLLM on a different port or
# a different host.
# MEMEX_INFERENCE__BASE_URL=http://127.0.0.1:8000/v1

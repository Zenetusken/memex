# Memex vault watcher env file — read by the systemd unit at
# ~/.config/systemd/user/memex-watch.service.
#
# The watcher has no knobs of its own — it follows the vault path
# from the global Memex config. This file exists for consistency
# with the other deploy units (vllm, web, mcp); leave everything
# commented unless you need to override.

# ── Vault location (only if non-default) ────────────────────────────
# MEMEX_VAULT_PATH=%h/.memex/vault

# ── Observability ───────────────────────────────────────────────────
# MEMEX_OBSERVABILITY__LANGFUSE_ENABLED=false
# MEMEX_OBSERVABILITY__LANGFUSE_PUBLIC_KEY=
# MEMEX_OBSERVABILITY__LANGFUSE_SECRET_KEY=

# ── vLLM endpoint override (only if non-default) ────────────────────
# MEMEX_INFERENCE__BASE_URL=http://127.0.0.1:8000/v1

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual envs and tool caches
.venv/
.uv/
.ruff_cache/
.pyright/
.mypy_cache/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Editors and OS cruft
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*.bak
*.tmp

# Env files — may contain secrets; never commit (.env.example is safe)
.env
.env.*
!.env.example

# Memex-specific
# User vault data — never commit. Anchored to project root so the
# `src/memex/vault/` source module isn't accidentally swept up.
/vault/
# Local Langfuse trace exports
.langfuse/
# Local model cache
.cache/
# Local config (may contain machine-specific paths / keys)
.memex/
*.local.toml
*.local.env

# Restic password files. docs/deploy/backup.md keeps these under
# ~/.config/memex/, but defensive against the `printf … > restic-password`
# recipe being accidentally run from inside the repo.
restic-password*

# Eval run outputs
tests/eval-results/

# Defensive — not currently used but cheap to ignore
node_modules/

# Claude Code transient runtime lock (the workflows/ scripts stay tracked)
.claude/scheduled_tasks.lock

# mkdocs build output (`uv run mkdocs build` → site/; regenerable, never committed)
/site/
